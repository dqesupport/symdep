#!/usr/bin/env php
<?php
/*
 * symdep — wrapper around Deployer 7's `dep` PHAR.
 *
 * Deployer 7 ships its own bin/dep PHAR and is no longer embeddable as a
 * library (its composer.json has no autoload section). So instead of
 * constructing a Deployer instance ourselves, we resolve the consumer's
 * `deploy.php` and `vendor/bin/dep`, then exec `dep` with our recipe
 * (recipe/symdep.php) as the deploy file. recipe/symdep.php pulls in the
 * symfony recipes and finally requires the consumer's real deploy.php.
 */

namespace TheRat\SymDep;

if (!defined('SYMDEP_BIN')) {
    define('SYMDEP_BIN', __FILE__);
}

// 1. Resolve the consumer's deploy.php (same lookup as before: -f / --file
//    or walk up from cwd).
$cliOptions = getopt('f::', ['file::']);
$userDeployFile = $cliOptions['f'] ?? $cliOptions['file'] ?? null;

if (!empty($userDeployFile)) {
    $deployFile = ($userDeployFile[0] === '/' ? '' : getcwd() . '/') . $userDeployFile;
} else {
    $deployFile = getcwd() . '/deploy.php';
    if (!is_readable($deployFile)) {
        $currentDir = getcwd();
        $count = 0;
        do {
            $currentDir = dirname($currentDir);
            $deployFile = $currentDir . '/deploy.php';
            $count++;
        } while (!is_readable($deployFile) && $count < 100 && $currentDir !== '/');
    }
}

if (!is_readable($deployFile)) {
    fwrite(STDERR, "Cannot find deploy.php (use -f to specify a path)." . PHP_EOL);
    exit(1);
}

$deployFile = realpath($deployFile);
$deployDir = dirname($deployFile);

// 2. Locate the consumer's vendor/autoload.php so symdep's helper classes
//    (TheRat\SymDep\*) can be autoloaded inside the dep PHAR process.
$autoloadCandidates = [
    $deployDir . '/vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
    __DIR__ . '/../vendor/autoload.php',
];
$autoload = null;
foreach ($autoloadCandidates as $file) {
    if (file_exists($file)) {
        $autoload = realpath($file);
        break;
    }
}

if ($autoload === null) {
    fwrite(STDERR, 'Cannot find vendor/autoload.php — run "composer install".' . PHP_EOL);
    exit(1);
}

// 3. Locate the Deployer 7 PHAR. Composer's bin-dir is configurable, so
//    check both the conventional vendor/bin and the project bin/ override.
$depCandidates = [
    $deployDir . '/bin/dep',
    $deployDir . '/vendor/bin/dep',
    dirname($autoload) . '/bin/dep',
    $deployDir . '/vendor/deployer/deployer/bin/dep',
    __DIR__ . '/../vendor/bin/dep',
    __DIR__ . '/../vendor/deployer/deployer/bin/dep',
];
$dep = null;
foreach ($depCandidates as $file) {
    if (file_exists($file)) {
        $dep = realpath($file);
        break;
    }
}

if ($dep === null) {
    fwrite(STDERR, 'Cannot find Deployer "dep" binary in vendor/bin/dep.' . PHP_EOL);
    exit(1);
}

// 4. The recipe entry point we feed to dep.
$symdepRecipe = realpath(__DIR__ . '/../recipe/symdep.php');
if ($symdepRecipe === false || !is_readable($symdepRecipe)) {
    fwrite(STDERR, 'Cannot locate recipe/symdep.php.' . PHP_EOL);
    exit(1);
}

// 5. Pass deploy file + autoload path to the recipe via environment.
putenv('SYMDEP_USER_DEPLOY_FILE=' . $deployFile);
putenv('SYMDEP_USER_AUTOLOAD=' . $autoload);
$_ENV['SYMDEP_USER_DEPLOY_FILE'] = $deployFile;
$_ENV['SYMDEP_USER_AUTOLOAD'] = $autoload;

// Anchor Deployer 7's working directory to the consumer's project root.
// Without this, ProcessRunner defaults cwd to dirname(DEPLOYER_DEPLOY_FILE),
// which would be symdep's recipe/ folder — causing run()/runLocally() to
// execute inside symdep instead of the project. See ProcessRunner::run().
putenv('DEPLOYER_ROOT=' . $deployDir);
$_ENV['DEPLOYER_ROOT'] = $deployDir;

// 6. Forward all argv (minus -f / --file, which we override) to dep.
$forward = [];
$skipNext = false;
foreach (array_slice($_SERVER['argv'], 1) as $arg) {
    if ($skipNext) {
        $skipNext = false;
        continue;
    }
    if ($arg === '-f' || $arg === '--file') {
        $skipNext = true;
        continue;
    }
    if (str_starts_with($arg, '-f=') || str_starts_with($arg, '--file=')) {
        continue;
    }
    $forward[] = $arg;
}

$cmd = escapeshellarg($dep) . ' -f ' . escapeshellarg($symdepRecipe);
foreach ($forward as $arg) {
    $cmd .= ' ' . escapeshellarg($arg);
}

passthru($cmd, $code);
exit($code);
