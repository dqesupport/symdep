{
    "name": "therat/symdep",
    "description": "Additional tool for symfony deploy",
    "require": {
        "php": ">=8.0",
        "deployer/deployer": "^7.5",
        "symfony/console": "^5.4 || ^6.0 || ^7.0",
        "symfony/finder": "^5.4 || ^6.0 || ^7.0",
        "symfony/process": "^5.4 || ^6.0 || ^7.0",
        "symfony/yaml": "^5.4 || ^6.0 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "minimum-stability": "stable",
    "license": "MIT",
    "authors": [
        {
            "name": "Vladimir Pak",
            "email": "the_rat_spam@mail.ru"
        }
    ],
    "extra": {
        "branch-alias": {
            "dev-master": "7.0.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "TheRat\\SymDep\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TheRat\\SymDep\\Tests\\": "src/Tests/"
        }
    },
    "bin": [
        "bin/symdep",
        "bin/project-update",
        "bin/symdep-project-deploy-on-test",
        "bin/symdep-project-deploy-on-prod",
        "bin/project-drop-branches-from-test"
    ]
}
